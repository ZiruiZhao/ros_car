<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roscar_bridge</name>
  <version>0.1.0</version>
  <description>
    ROS2 ↔ ESP32-S3 串口桥接节点。下行 geometry_msgs/Twist 编码成 0x01 二进制帧，
    上行按行解析板子的文本遥测，发布 nav_msgs/Odometry、sensor_msgs/Imu 和
    odom→base_link 的 TF。协议细节见 串口通信手册.md，对接步骤见 香橙派对接手册.md。
  </description>
  <maintainer email="orangepi@todo.todo">orangepi</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <!-- pyserial。rosdep key 就叫 python3-serial，不要写成 pyserial。 -->
  <exec_depend>python3-serial</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
